{
    "productName": "DiskMind",
    "version": "0.1.0",
    "identifier": "com.diskmind.app",
    "build": {
        "beforeDevCommand": "cd ../../ && pnpm --filter @bosguega/diskmind-types build && pnpm --filter disk-mind vite",
        "beforeBuildCommand": "cd ../../ && pnpm --filter @bosguega/diskmind-types build && pnpm --filter disk-mind build:frontend",
        "devUrl": "http://localhost:5173",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "title": "DiskMind",
                "width": 960,
                "height": 720,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "nsis",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}