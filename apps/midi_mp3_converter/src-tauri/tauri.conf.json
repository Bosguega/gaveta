{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MIDI MP3 Converter",
    "version": "0.1.0",
    "identifier": "com.bosguega.midi2mp3",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "MIDI → MP3 Converter",
                "width": 660,
                "height": 470,
                "minWidth": 560,
                "minHeight": 400,
                "resizable": true
            }
        ],
        "security": {
            "assetProtocol": {
                "enable": true,
                "scope": ["**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"]
    }
}