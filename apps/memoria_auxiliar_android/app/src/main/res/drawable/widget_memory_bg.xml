<?xml version="1.0" encoding="utf-8"?>
<!--
  Fundo do widget: pílula sólida escura (slate, mesmo tom do tema dark do app
  desktop) com cantos bem arredondados. Sólido de propósito: o widget precisa
  ser legível sobre qualquer wallpaper, sem depender da transparência.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="28dp" />

    <solid android:color="#1E293B" />

    <stroke
        android:width="1dp"
        android:color="#334155" />

</shape>
