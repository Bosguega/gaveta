{
  "name": "my_mercado",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "node scripts/dev.mjs --https",
    "build": "vite build",
    "build:cloudflare": "pnpm --filter @bosguega/ai-core build && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p supabase/functions/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "analyze": "npx vite-bundle-analyzer dist/stats.html",
    "lighthouse": "npx lighthouse http://localhost:5173 --output=json --output-path=./lighthouse-report.json",
    "test:perf": "npm run build && npm run lighthouse",
    "test:perf:auto": "node scripts/testPerformance.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": ""
  },
  "dependencies": {
    "@bosguega/ai-core": "workspace:*",
    "@bosguega/device-mode-core": "workspace:*",
    "@bosguega/supabase": "workspace:*",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/react-query": "^5.95.2",
    "currency.js": "^2.0.4",
    "date-fns": "^4.1.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-window": "^2.2.7",
    "recharts": "^3.8.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@bosguega/eslint-config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.2.4"
  }
}