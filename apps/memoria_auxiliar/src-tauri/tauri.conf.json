{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memoria Auxiliar",
  "version": "0.1.0",
  "identifier": "com.memoriaauxiliar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Memoria Auxiliar",
        "width": 960,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
