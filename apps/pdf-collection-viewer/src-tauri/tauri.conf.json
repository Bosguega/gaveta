{
    "productName": "Collection Viewer",
    "version": "0.1.0",
    "identifier": "com.pdfcollectionviewer.desktop",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "bundle": {
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": ["resources/pdfium.dll"]
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Collection Viewer",
                "width": 1400,
                "height": 900,
                "minWidth": 800,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false
            }
        ],
        "security": {
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/**",
                    "$HOME/**",
                    "$DESKTOP/**",
                    "$DOCUMENT/**",
                    "$PICTURE/**"
                ]
            }
        }
    }
}
