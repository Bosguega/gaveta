{
  "manifest_version": 3,
  "name": "POC NFC-e Capture 3",
  "version": "0.3.0",
  "description": "POC descartável de automação completa de captura de NFC-e",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://www.nfce.fazenda.sp.gov.br/*",
    "file:///*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.nfce.fazenda.sp.gov.br/*",
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}