{
  "manifest_version": 3,
  "name": "NFC-e Capture",
  "version": "1.0.0",
  "description": "Captura automática de NFC-e SEFAZ/SP",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://www.nfce.fazenda.sp.gov.br/*",
    "https://mymercado.pages.dev/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.nfce.fazenda.sp.gov.br/*",
        "https://mymercado.pages.dev/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}